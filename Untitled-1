7. **Create CRUD operations**:
-  Create a `crud.py` file   :
```python
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.future import select
from .models import ContactMessage

async def create_contact_message(db               : AsyncSession, contact_message):
db_contact_message                                = ContactMessage(**contact_message.dict())
db.add(db_contact_message)
await db.commit()
await db.refresh(db_contact_message)
return db_contact_message

async def get_contact_messages(db                 : AsyncSession, skip: int = 0, limit: int = 10):
result                                            = await db.execute(select(ContactMessage).offset(skip).limit(limit))
return result.scalars().all()

async def get_contact_message(db                  : AsyncSession, contact_message_id: int):
return await db.get(ContactMessage, contact_message_id)

async def update_contact_message(db               : AsyncSession, contact_message_id: int, contact_message):
db_contact_message                                = await db.get(ContactMessage, contact_message_id)
if db_contact_message is None                     :
return None
for key, value in contact_message.dict().items()  :
setattr(db_contact_message, key, value)
db.add(db_contact_message)
await db.commit()
await db.refresh(db_contact_message)
return db_contact_message

async def delete_contact_message(db               : AsyncSession, contact_message_id: int):
db_contact_message                                = await db.get(ContactMessage, contact_message_id)
if db_contact_message is None                     :
return None
await db.delete(db_contact_message)
await db.commit()
return db_contact_message
```

